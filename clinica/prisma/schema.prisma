datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Cita {
  id          Int      @id @default(autoincrement())
  nombre      String
  telefono    String
  email       String?
  fecha       DateTime
  hora        String
  tratamiento String
  notas       String?
  status      String   @default("PENDIENTE")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}